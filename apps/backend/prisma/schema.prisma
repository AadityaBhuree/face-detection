generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["jsonProtocol", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp, pgcrypto, vector]
}

enum SessionStatus {
  INITIATED
  FACE_MATCHED
  CONTEXT_LOADED
  INTAKE_IN_PROGRESS
  TRANSCRIBING
  BRIEF_GENERATED
  SYNCED
  COMPLETED
  FAILED
  TIMED_OUT
}

enum UserRole {
  RECEPTIONIST
  DOCTOR
  ADMIN
  SYSTEM
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─── Patient ───────────────────────────────────────────────────
model Patient {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(200)
  dob            DateTime        @db.Date
  mobile         String          @unique @db.VarChar(15)
  aadhaarRef     String?         @db.Char(64) // SHA-256 hash only
  consentGranted Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  faceEmbeddings  FaceEmbedding[]
  intakeSessions  IntakeSession[]
  intakeRecords   IntakeRecord[]

  @@map("patients")
}

// ─── Face Embedding ────────────────────────────────────────────
model FaceEmbedding {
  id         String   @id @default(uuid()) @db.Uuid
  patientId  String   @db.Uuid
  capturedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("face_embeddings")
}

// ─── Intake Session ────────────────────────────────────────────
model IntakeSession {
  id        String        @id @default(uuid()) @db.Uuid
  patientId String?       @db.Uuid
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  status    SessionStatus @default(INITIATED)
  deviceId  String        @db.VarChar(100)
  metadata  Json          @default("{}")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  patient     Patient?              @relation(fields: [patientId], references: [id], onDelete: SetNull)
  intakeRecords IntakeRecord[]
  transcripts   SessionTranscript[]

  @@index([patientId])
  @@index([status])
  @@index([startedAt])
  @@map("intake_sessions")
}

// ─── Session Transcript ────────────────────────────────────────
model SessionTranscript {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @db.Uuid
  speaker     String   @db.VarChar(20) // 'patient', 'ai', 'system'
  text        String   @db.Text
  timestampMs BigInt
  createdAt   DateTime @default(now())

  session IntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([timestampMs])
  @@map("session_transcripts")
}

// ─── Intake Record (Clinical Brief) ────────────────────────────
model IntakeRecord {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @db.Uuid
  patientId   String   @db.Uuid
  brief       Json     // ClinicalBrief
  intakeData  Json     // IntakeData
  generatedAt DateTime @default(now())

  session IntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([patientId])
  @@index([generatedAt])
  @@map("intake_records")
}

// ─── Audit Log ─────────────────────────────────────────────────
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  action       String   @db.VarChar(200)
  actorId      String   @db.VarChar(100)
  actorRole    UserRole
  resourceType String   @db.VarChar(100)
  resourceId   String   @db.VarChar(100)
  details      Json     @default("{}")
  ipAddress    String   @db.VarChar(45)
  timestamp    DateTime @default(now())

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ─── Clinic User ───────────────────────────────────────────────
model ClinicUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  name         String   @db.VarChar(200)
  role         UserRole @default(RECEPTIONIST)
  clinicId     String?  @db.VarChar(100)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([clinicId])
  @@map("clinic_users")
}

// ─── PMS Patient Cache (for offline-first) ─────────────────────
model PmsPatientCache {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @unique @db.Uuid
  data        Json     // Full patient data from PMS
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pms_patient_cache")
}
