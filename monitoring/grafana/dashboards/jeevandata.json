        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(jeevandata_http_errors_total[5m])) / clamp_min(sum(rate(jeevandata_http_requests_total[5m])), 0.0001) * 100",
          "legendFormat": "5xx rate",
          "refId": "A"
        }
      ],
      "title": "HTTP Error Rate (5xx)",
      "type": "stat"
    },
